{
  "name": "cypress-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "testAllSpecs": "cypress run",
    "reportingPage": "npx cypress run --spec cypress/e2e/reportCard.cy.js",
    "headed": "cypress run --headed",
    "chrome": "npm run headed --browser chrome",
    "reportCard": "cypress run --record --key 84301b20-b721-4410-b403-2143093c64d9 --spec \"cypress/e2e/reportCard.cy.js*/\"",
    "cypressCloud": "cypress run --record --key 84301b20-b721-4410-b403-2143093c64d9",
    "hooksVoyager": "cypress run --spec \"cypress/e2e/hooksVoyager.cy.js\"",
    "html_report_reportCard": "cypress run --reporter mochawesome -- --spec \"cypress/e2e/reportCard.cy.js\"",
    "login": "cypress run --record --key 84301b20-b721-4410-b403-2143093c64d9 --spec cypress/e2e/login.cy.js",
    "permGreenTasksList": "cypress run --record --key 84301b20-b721-4410-b403-2143093c64d9 --spec cypress/e2e/permGreenTasksList.cy.js",
    "html_report_all_specs": "cypress run --record --key 84301b20-b721-4410-b403-2143093c64d9 --reporter mochawesome",
    "merge_reports": "mochawesome-merge cypress/results/*.json -o cypress/mochawesome-merged/merged.json",
    "generate_html_report": "npx mochawesome-report-generator cypress/mochawesome-merged/merged.json -o mochawesome-html-report -f merged.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cypress": "^13.3.0"
  },
  "devDependencies": {
    "cypress-file-upload": "^5.0.8",
    "cypress-iframe": "^1.0.1",
    "cypress-wait-until": "^2.0.1",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
